# MongoDB connection string (required)
DB_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/yourtube?retryWrites=true&w=majority

# Comma-separated list of allowed frontend origins
# For Render: add your Vercel deployment URL here too
CLIENT_URL=http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=

# Server port (Render sets this automatically)
PORT=5000

# Optional upload directory override
UPLOAD_DIR=./uploads
